# ==========================================
# ShopLedger - Environment Configuration Template
# ==========================================

# ------------------------------------------
# Frontend (Vite)
# ------------------------------------------
# Set to backend URL when running full-stack (e.g. http://localhost:8000).
# Leave empty to run frontend in standalone mock mode.
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------
# Backend (FastAPI) - Required for live backend
# ------------------------------------------
# Google Gemini API key (Backend only - NEVER expose to browser/client code)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for structured receipt extraction
GEMINI_MODEL=gemini-3.5-flash

# Backend server host and port
HOST=0.0.0.0
PORT=8000

# SQLite database path
DATABASE_PATH=backend/data/shopledger.db

# Receipt file storage directory
UPLOAD_DIR=backend/data/uploads

# Maximum upload file size in bytes (10MB = 10485760)
MAX_FILE_SIZE_BYTES=10485760

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
