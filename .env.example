# ==========================================
# ShopLedger - Environment Configuration Template
# ==========================================

# ------------------------------------------
# Frontend (Vite)
# ------------------------------------------
# Set to a backend URL when it is not available through the Vite /api proxy.
# Use "mock" only to run receipt screens against sample data; auth still needs the backend.
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------
# Backend (FastAPI) - Required for live backend
# ------------------------------------------
# Supabase persistence (set these on Render to persist data without a Render disk)
# DATABASE_URL=postgresql://... (Supabase Database connection string, preferably Session Pooler)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# SUPABASE_STORAGE_BUCKET=receipt-files

# Google Gemini API key (Backend only - NEVER expose to browser/client code)
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for structured receipt extraction
GEMINI_MODEL=gemini-3.5-flash

# Backend server host and port
HOST=0.0.0.0
PORT=8000

# Local SQLite database path (used when DATABASE_URL is empty)
DATABASE_PATH=backend/data/shopledger.db

# Local receipt file storage directory (used when Supabase Storage is not configured)
UPLOAD_DIR=backend/data/uploads

# Maximum upload file size in bytes (10MB = 10485760)
MAX_FILE_SIZE_BYTES=10485760

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
